{
  "package": "@tagreel/player",
  "subpaths": {
    ".": {
      "source": "./dist/tagreel-player.js",
      "runtime": {
        "script": "./dist/tagreel-player.global.js",
        "import": "./dist/tagreel-player.js",
        "require": "./dist/tagreel-player.cjs"
      },
      "types": "./dist/tagreel-player.d.ts",
      "environments": ["browser"]
    },
    "./slideshow": {
      "source": "./dist/slideshow/tagreel-slideshow.js",
      "runtime": {
        "script": "./dist/slideshow/tagreel-slideshow.global.js",
        "import": "./dist/slideshow/tagreel-slideshow.js",
        "require": "./dist/slideshow/tagreel-slideshow.cjs"
      },
      "types": "./dist/slideshow/tagreel-slideshow.d.ts",
      "environments": ["browser"]
    }
  }
}
