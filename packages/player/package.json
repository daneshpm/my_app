{
  "name": "@tagreel/player",
  "version": "0.8.137",
  "description": "Embeddable web component for Tagreel compositions",
  "repository": {
    "type": "git",
    "url": "https://github.com/daneshpm/my_app",
    "directory": "packages/player"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/tagreel-player.js",
  "types": "./dist/tagreel-player.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tagreel-player.d.ts",
      "script": "./dist/tagreel-player.global.js",
      "import": "./dist/tagreel-player.js",
      "require": "./dist/tagreel-player.cjs"
    },
    "./slideshow": {
      "types": "./dist/slideshow/tagreel-slideshow.d.ts",
      "script": "./dist/slideshow/tagreel-slideshow.global.js",
      "import": "./dist/slideshow/tagreel-slideshow.js",
      "require": "./dist/slideshow/tagreel-slideshow.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/verify-runtime-pin.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/perf/tsconfig.json",
    "test": "vitest run",
    "test:browser-security": "bun run tests/browser/sandbox-origin.ts",
    "perf": "bun run tests/perf/index.ts"
  },
  "dependencies": {
    "@tagreel/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "gsap": "^3.15.0",
    "puppeteer-core": "^25.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
